module

public import NRS3Hopf.ClosedThree
public import Mathlib.Algebra.Lie.SkewAdjoint

/-!
# The open axis preserves a form, the closed axis does not

The spectrum `2 cos(jπ/(d+1))/ρ` of `T_d` is symmetric, `j ↦ d + 1 − j` sends `λ` to `−λ`, for
every `d` and in the Szegő limit. In matrices the symmetry is `K_d = J R`, with `J = diag((−1)^i)`
the sign of the steps and `R` the mirror `i ↦ d − 1 − i`: `J` flips `T_d` and fixes `P_d`, `R`
fixes `T_d` and flips the centred `P_d`. So

  `T_dᵀ K_d = −K_d T_d`,  `P_dᵀ K_d = −K_d P_d`,

and `T_d`, `P_d` and all their brackets preserve the form `K_d`, which is symmetric for `d` odd
and antisymmetric for `d` even: the Lie algebra of the open axis lies in `so(d)` or `sp(d)`.

The closed axis with three positions is an odd ring, with spectrum `{1, −1/2, −1/2}`, not
symmetric: no nonzero `K` satisfies both relations for `T°` and `P₃`.

## Main results

- `OpenAxisForm.K_transpose` : `K_dᵀ = (−1)^(d+1) K_d`.
- `OpenAxisForm.K_mul_K` : `K_d K_d = (−1)^(d+1)`, so `K_d` is invertible.
- `OpenAxisForm.Td_mem`, `OpenAxisForm.Pd_mem` : `T_d`, `P_d` are skew-adjoint for `K_d`.
- `OpenAxisForm.lieSpan_le` : the Lie algebra generated by `T_d`, `P_d` preserves `K_d`.
- `OpenAxisForm.eq_zero_of_closed` : the closed axis preserves no nonzero form of this kind.
-/

@[expose] public noncomputable section

open Matrix TransportPosition

attribute [local instance 100] LieRing.ofAssociativeRing LieAlgebra.ofAssociativeAlgebra

namespace OpenAxisForm

variable {d : ℕ}

/-- The form `K_d = J R` of the open axis: `(−1)^i` on the antidiagonal. -/
def K (d : ℕ) : Matrix (Fin d) (Fin d) ℂ := of fun i j => if j = i.rev then (-1) ^ i.val else 0

theorem K_apply (i j : Fin d) : K d i j = if j = i.rev then (-1) ^ i.val else 0 := rfl

theorem mul_K_apply (A : Matrix (Fin d) (Fin d) ℂ) (i j : Fin d) :
    (A * K d) i j = A i j.rev * (-1) ^ j.rev.val := by
  rw [Matrix.mul_apply, Finset.sum_eq_single j.rev]
  · simp [K_apply]
  · intro k _ hk
    have : ¬ j = k.rev := fun h => hk (by rw [h, Fin.rev_rev])
    simp [K_apply, this]
  · simp

theorem K_mul_apply (A : Matrix (Fin d) (Fin d) ℂ) (i j : Fin d) :
    (K d * A) i j = (-1) ^ i.val * A i.rev j := by
  rw [Matrix.mul_apply, Finset.sum_eq_single i.rev]
  · simp [K_apply]
  · intro k _ hk
    simp [K_apply, hk]
  · simp

private theorem neg_one_pow_rev (i : Fin d) :
    ((-1 : ℂ) ^ i.rev.val) = (-1) ^ (d + 1) * (-1) ^ i.val := by
  rw [← pow_add, show d + 1 + i.val = i.rev.val + 2 * (i.val + 1) by rw [Fin.val_rev]; omega,
    pow_add, pow_mul]
  simp

/-- **`K_d` is symmetric for `d` odd and antisymmetric for `d` even.** -/
theorem K_transpose : (K d)ᵀ = (-1 : ℂ) ^ (d + 1) • K d := by
  ext i j
  rw [transpose_apply, Matrix.smul_apply, K_apply, K_apply]
  change _ = (-1 : ℂ) ^ (d + 1) * _
  by_cases h : j = i.rev
  · subst h
    simp only [Fin.rev_rev, ite_true]
    exact neg_one_pow_rev i
  · have h' : ¬ i = j.rev := fun h' => h (by rw [h', Fin.rev_rev])
    simp [h, h']

/-- **`K_d K_d = (−1)^(d+1)`**, so the form is nondegenerate. -/
theorem K_mul_K : K d * K d = (-1 : ℂ) ^ (d + 1) • (1 : Matrix (Fin d) (Fin d) ℂ) := by
  ext i j
  rw [K_mul_apply, Matrix.smul_apply, one_apply, K_apply, Fin.rev_rev]
  change _ = (-1 : ℂ) ^ (d + 1) * _
  by_cases h : j = i
  · subst h
    simp only [ite_true, mul_one]
    rw [neg_one_pow_rev, ← mul_assoc, mul_comm ((-1 : ℂ) ^ j.val), mul_assoc, ← pow_add,
      ← two_mul, pow_mul]
    simp
  · simp [h, Ne.symm h]

theorem minStep_rev {i j : Fin d} : MinStep j.rev i ↔ MinStep i.rev j := by
  simp only [MinStep, Fin.val_rev]; omega

/-- **`T_d` is skew-adjoint for `K_d`**: `J` flips the steps, `R` keeps them. -/
theorem Td_mem : Td d ∈ skewAdjointMatricesSubmodule (K d) := by
  rw [mem_skewAdjointMatricesSubmodule]
  show (Td d)ᵀ * K d = K d * (-Td d)
  ext i j
  rw [mul_K_apply, K_mul_apply, transpose_apply, neg_apply]
  simp only [Td, Ad]
  by_cases h : MinStep j.rev i
  · have h' : MinStep i.rev j := minStep_rev.mp h
    simp only [h, h', ite_true]
    rw [neg_one_pow_rev j]
    have hp : (-1 : ℂ) ^ (d + 1) * (-1) ^ j.val = -(-1) ^ i.val := by
      rw [← pow_add]
      simp only [MinStep, Fin.val_rev] at h
      rcases h with h | h
      · rw [show d + 1 + j.val = 2 * j.val + i.val + 1 by omega, pow_add, pow_add, pow_mul]
        simp
      · rw [show d + 1 + j.val = 2 * (j.val + 1) + i.val + 1 by omega, pow_add, pow_add, pow_mul]
        simp
    rw [hp]; ring
  · have h' : ¬ MinStep i.rev j := fun h' => h (minStep_rev.mpr h')
    simp [h, h']

theorem posCoord_rev (i : Fin d) : posCoord d i.rev = -posCoord d i := by
  have hi : ((i.rev.val : ℕ) : ℝ) = (d : ℝ) - (i.val + 1) := by
    rw [Fin.val_rev, Nat.cast_sub (by omega)]; push_cast; ring
  simp only [posCoord, hi]
  ring

/-- **`P_d` is skew-adjoint for `K_d`**: `R` flips the centred positions, `J` keeps them. -/
theorem Pd_mem : Pd d ∈ skewAdjointMatricesSubmodule (K d) := by
  rw [mem_skewAdjointMatricesSubmodule]
  show (Pd d)ᵀ * K d = K d * (-Pd d)
  ext i j
  rw [mul_K_apply, K_mul_apply, transpose_apply, neg_apply]
  simp only [Pd]
  by_cases h : j.rev = i
  · have h' : i.rev = j := by rw [← h, Fin.rev_rev]
    simp only [h, h', ite_true]
    rw [← h', posCoord_rev]
    push_cast
    ring
  · have h' : ¬ i.rev = j := fun h' => h (by rw [← h', Fin.rev_rev])
    simp [h, h']

/-- **The Lie algebra generated by `T_d`, `P_d` preserves `K_d`**: it lies in `so(d)` for `d`
odd and in `sp(d)` for `d` even. -/
theorem lieSpan_le :
    LieSubalgebra.lieSpan ℂ _ {Td d, Pd d} ≤ skewAdjointMatricesLieSubalgebra (K d) := by
  rw [LieSubalgebra.lieSpan_le]
  rintro _ (rfl | rfl)
  exacts [Td_mem, Pd_mem]

/-- **The closed axis preserves no nonzero form of this kind**: `T°ᵀ K = −K T°` and
`P₃ᵀ K = −K P₃` force `K = 0`. -/
theorem eq_zero_of_closed {M : Matrix (Fin 3) (Fin 3) ℂ}
    (hT : ClosedThree.Tcᵀ * M = M * (-ClosedThree.Tc)) (hP : (Pd 3)ᵀ * M = M * (-Pd 3)) :
    M = 0 := by
  have hp (i j : Fin 3) := congrFun (congrFun hP i) j
  have ht (i j : Fin 3) := congrFun (congrFun hT i) j
  have a00 := hp 0 0; have a01 := hp 0 1; have a10 := hp 1 0; have a12 := hp 1 2
  have a21 := hp 2 1; have a22 := hp 2 2
  have b00 := ht 0 0; have b01 := ht 0 1; have b10 := ht 1 0
  simp [Matrix.mul_apply, Pd, posCoord] at a00 a01 a10 a12 a21 a22
  simp [Matrix.mul_apply, Fin.sum_univ_three, ClosedThree.Tc] at b00 b01 b10
  norm_num at a00 a01 a10 a12 a21 a22 b00 b01 b10
  have z00 : M 0 0 = 0 := by linear_combination -a00 / 2
  have z22 : M 2 2 = 0 := by linear_combination a22 / 2
  have z02 : M 0 2 = 0 := by
    linear_combination b00 + b01 - b10 + a10 / 2 - a01 / 2 + a12 / 2 - a21 / 2
  have z11 : M 1 1 = 0 := by linear_combination 2 * b01 - a21 - z02 + a00 / 2
  have z20 : M 2 0 = 0 := by linear_combination 2 * b10 + a00 / 2 - a12 - z11
  ext i j
  fin_cases i <;> fin_cases j
  all_goals simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Matrix.zero_apply]
  all_goals first
    | assumption
    | exact a10.symm

end OpenAxisForm
