module

public import NRS3Hopf.OpenNoRotation
public import NRS3Hopf.BoxExcess

/-!
# The conserved rotation of the closed fiber saturates Robertson

On the closed axis with three positions the transport conserves the rotation generated by
`K = U − Uᵀ` (`SpinAxes`). Its angular momentum about the axis `(1, 1, 1)` is the Hermitian
`L = (i/√3) K`, with eigenvalues `−1, 0, 1`, and `[T°, L] = 0`.

Take the pair `(L, P₃)` on the fiber instead of `(T°, P₃)`. The state `ψ* ∝ (1, 1 − √3, 1)` is
annihilated by `L + iP₃`, so its two fluctuation vectors are parallel and Robertson saturates
on the fiber (`D23`), with tension `≠ 0`. The transport pair has the band `|t| > 1` where the
defect is forced and the factor `F = 5/4`; the conserved rotation has none.

On the box with `2` or `3` positions on `x`, `y`, `z` at their maximal current states and the
fiber at `ψ*`, `det Σ₈ = |det Ω₈|`: the conserved rotation adds no excess.

## Main results

- `RotationFiber.Lr_isHermitian`, `RotationFiber.lie_Tc_Lr` : `L` is Hermitian and conserved.
- `RotationFiber.ladder` : `(L + iP₃) ψ* = 0`.
- `RotationFiber.fiber_saturates` : Robertson saturates on the fiber at `ψ*`.
- `RotationFiber.imPart_pos` : with a nonzero tension.
- `RotationFiber.robertson_det_box_rot` : `det Σ₈ = |det Ω₈|` on the box.
-/

@[expose] public noncomputable section

open Matrix TransportPosition PathGraph3DNRS RobertsonDeterminant FourAxes CubeInBox
open NRSInequality EigenvectorSaturation Complex DimensionalQuantum Gnomon SpectralExtremal

attribute [local instance 100] LieRing.ofAssociativeRing LieAlgebra.ofAssociativeAlgebra

namespace RotationFiber

/-! ## 1. The angular momentum of the fiber -/

/-- The angular momentum about the axis `(1, 1, 1)`, `L = (i/√3) K`. -/
def Lr : Matrix (Fin 3) (Fin 3) ℂ := (I / ((√3 : ℝ) : ℂ)) • SpinAxes.K

theorem Lr_isHermitian : Lr.IsHermitian := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Lr, SpinAxes.K, SpinAxes.U, conjTranspose_apply, neg_div]

/-- **The transport conserves the angular momentum**: `[T°, L] = 0`. -/
theorem lie_Tc_Lr : ⁅ClosedThree.Tc, Lr⁆ = 0 := by
  rw [Lr, lie_smul, SpinAxes.lie_Tc_K, smul_zero]

/-- The pair of the fiber: the conserved angular momentum and the position. -/
def rotPair : Fin 2 → Matrix (Fin 3) (Fin 3) ℂ := ![Lr, Pd 3]

theorem rotPair_isHermitian : ∀ a, (rotPair a).IsHermitian := by
  intro a; fin_cases a
  exacts [Lr_isHermitian, Pd_isHermitian 3]

/-! ## 2. The state annihilated by `L + iP₃` -/

private theorem h3 : ((√3 : ℝ) : ℂ) ^ 2 = 3 := by
  rw [← Complex.ofReal_pow, Real.sq_sqrt (by norm_num)]; norm_num

private theorem h3' : ((√3 : ℝ) : ℂ) ≠ 0 := by
  exact_mod_cast (Real.sqrt_pos.mpr (by norm_num : (0 : ℝ) < 3)).ne'

/-- The direction `(1, 1 − √3, 1)`. -/
def v : Fin 3 → ℂ := ![1, 1 - ((√3 : ℝ) : ℂ), 1]

/-- **`L + iP₃` annihilates `(1, 1 − √3, 1)`.** -/
theorem ladder : (Lr + I • Pd 3) *ᵥ v = 0 := by
  ext i
  fin_cases i <;>
    simp [Lr, SpinAxes.K, SpinAxes.U, v, Pd, posCoord, Matrix.mulVec, dotProduct,
      Fin.sum_univ_three]
  all_goals field_simp
  all_goals ring_nf
  all_goals simp

/-- The normalization `‖(1, 1 − √3, 1)‖² = 6 − 2√3`. -/
def c : ℝ := (√(6 - 2 * √3))⁻¹

/-- The unit state `ψ* = c (1, 1 − √3, 1)`. -/
def rotState : Hd 3 := WithLp.toLp 2 ((c : ℂ) • v)

theorem norm_rotState : ‖rotState‖ = 1 := by
  have hs : (0 : ℝ) < 6 - 2 * √3 := by
    have : √3 < 3 := by
      rw [Real.sqrt_lt' (by norm_num)]; norm_num
    linarith
  have h : ‖rotState‖ ^ 2 = 1 := by
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)]
    simp only [rotState, Fin.sum_univ_three, PiLp.toLp_apply, Pi.smul_apply, smul_eq_mul,
      norm_mul, mul_pow, Complex.norm_real, v]
    simp [c, Real.norm_eq_abs, sq_abs, Real.sq_sqrt hs.le, inv_pow]
    have : ‖(1 : ℂ) - ((√3 : ℝ) : ℂ)‖ ^ 2 = (1 - √3) ^ 2 := by
      rw [← Complex.ofReal_one, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs,
        sq_abs]
    rw [this]
    field_simp
    nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ 3 by norm_num)]
  have := norm_nonneg rotState
  nlinarith [sq_nonneg (‖rotState‖ - 1)]

theorem ladder_state : wPair rotPair 0 rotState - (I * ((-1 : ℝ) : ℂ)) • wPair rotPair 1 rotState =
    (0 : ℂ) • rotState := by
  have hl := ladder
  ext i
  have hi := congrFun hl i
  simp only [Matrix.add_mulVec, Matrix.smul_mulVec, Pi.add_apply, Pi.smul_apply, smul_eq_mul,
    Pi.zero_apply] at hi
  simp only [wPair, rotPair, Matrix.cons_val_zero, Matrix.cons_val_one, rotState,
    Matrix.toEuclideanLin, Matrix.toLpLin_apply, PiLp.sub_apply, PiLp.smul_apply, zero_smul,
    PiLp.zero_apply, mulVec_smul, Pi.smul_apply, smul_eq_mul]
  push_cast
  linear_combination (c : ℂ) * hi

/-! ## 3. Saturation on the fiber -/

theorem e0 (ψ : Hd 3) : centeredG (wPair rotPair 0) ψ = centered (wPair rotPair 0) ψ := rfl
theorem e1 (ψ : Hd 3) : centeredG (wPair rotPair 1) ψ = centered (wPair rotPair 1) ψ := rfl

theorem hsymm (a : Fin 2) : (wPair rotPair a).IsSymmetric :=
  Matrix.isSymmetric_toEuclideanLin_iff.mpr (rotPair_isHermitian a)

/-- **Robertson saturates on the fiber** at `ψ*`. -/
theorem fiber_saturates :
    (covMatrix (wPair rotPair) rotState).det = |(imMatrix (wPair rotPair) rotState).det| := by
  obtain ⟨hcov, hvar⟩ := saturation_of_eigenvector (hsymm 0) (hsymm 1) norm_rotState (-1) 0
    ladder_state
  have h0 (x : Hd 3) : (inner ℂ x x).im = 0 := by simpa using inner_self_im (𝕜 := ℂ) x
  have hn (x : Hd 3) : (inner ℂ x x).re = ‖x‖ ^ 2 := inner_self_eq_norm_sq (𝕜 := ℂ) x
  rw [det_fin_two, det_fin_two]
  simp only [covMatrix, imMatrix, of_apply, covarianceG, e0, e1, h0, hn]
  have hsw : (inner ℂ (centered (wPair rotPair 1) rotState)
      (centered (wPair rotPair 0) rotState)).re = (inner ℂ (centered (wPair rotPair 0) rotState)
        (centered (wPair rotPair 1) rotState)).re := by
    rw [← inner_conj_symm, Complex.conj_re]
  rw [hsw, RobertsonDeterminant3D.inner_im_swap]
  unfold variance covariance imPart at *
  rw [hcov, hvar]
  rw [RobertsonDeterminant3D.inner_im_swap (centered (wPair rotPair 0) rotState)
    (centered (wPair rotPair 1) rotState)]
  set x := (inner ℂ (centered (wPair rotPair 0) rotState) (centered (wPair rotPair 1) rotState)).im
  rw [show (0 : ℝ) * 0 - - -x * -x = x ^ 2 by ring, abs_of_nonneg (sq_nonneg x)]
  ring

/-- **The tension of `ψ*` is not zero**: `Im ⟪L̃ψ*, P̃ψ*⟫ = ‖P̃ψ*‖² > 0`, the saturation is not the
empty `0 = 0`. -/
theorem imPart_pos : 0 < imPart (wPair rotPair 0) (wPair rotPair 1) rotState := by
  have ha := annihilated_of_eigenvector (hsymm 0) (hsymm 1) norm_rotState (-1) 0 ladder_state
  set b := centered (wPair rotPair 1) rotState
  have hval : imPart (wPair rotPair 0) (wPair rotPair 1) rotState = ‖b‖ ^ 2 := by
    rw [imPart, ha, inner_smul_left, inner_self_eq_norm_sq_to_K]
    simp
    rw [← Complex.ofReal_pow, Complex.ofReal_re]
  rw [hval]
  refine pow_pos (norm_pos_iff.mpr fun hb => ?_) 2
  have hc : (c : ℂ) ≠ 0 := by
    have : (0 : ℝ) < 6 - 2 * √3 := by
      have : √3 < 3 := by rw [Real.sqrt_lt' (by norm_num)]; norm_num
      linarith
    exact_mod_cast inv_ne_zero (Real.sqrt_pos.mpr this).ne'
  have b0 := congrArg (fun x : Hd 3 => x 0) hb
  have b2 := congrArg (fun x : Hd 3 => x 2) hb
  simp [b, centered, wPair, rotPair, rotState, v, Matrix.toEuclideanLin, Matrix.toLpLin_apply,
    Matrix.mulVec, dotProduct, Pd, posCoord] at b0 b2
  norm_num at b0 b2
  apply hc
  linear_combination (b2 - b0) / 2

/-! ## 4. The box with the conserved rotation -/

variable {dx dy dz : ℕ}

theorem coherence_one {d : ℕ} (hd : d = 2 ∨ d = 3) : CoherenceConstant d = 1 := by
  have h := (dimQuantum_eq_zero_iff (by omega)).mpr hd
  rw [dimQuantum] at h
  rw [CoherenceConstant_eq_one_add_geometricGap, h, add_zero]

/-- **The conserved rotation adds no excess**: with `2` or `3` positions on `x`, `y`, `z` at
their maximal current states and the fiber at `ψ*`, `det Σ₈ = |det Ω₈|`. -/
theorem robertson_det_box_rot (hx : dx = 2 ∨ dx = 3) (hy : dy = 2 ∨ dy = 3)
    (hz : dz = 2 ∨ dz = 3) :
    (covMatrix (boxPairs dx dy dz 3 rotPair)
        (prod4 (maxCurrentState dx) (maxCurrentState dy) (maxCurrentState dz) rotState)).det =
      |(imMatrix (boxPairs dx dy dz 3 rotPair)
        (prod4 (maxCurrentState dx) (maxCurrentState dy) (maxCurrentState dz) rotState)).det| := by
  have hx2 : 2 ≤ dx := by omega
  have hy2 : 2 ≤ dy := by omega
  have hz2 : 2 ≤ dz := by omega
  rw [det_covMatrix_box (norm_maxCurrentState hx2) (norm_maxCurrentState hy2)
      (norm_maxCurrentState hz2) norm_rotState rotPair_isHermitian,
    abs_det_imMatrix_box (norm_maxCurrentState hx2) (norm_maxCurrentState hy2)
      (norm_maxCurrentState hz2) norm_rotState rotPair_isHermitian,
    ← CubeSpectrum.maxCurrentCubeState_eq_prod3,
    BoxExcess.det_covMatrix_cube_maxCurrent hx2 hy2 hz2, fiber_saturates, coherence_one hx,
    coherence_one hy, coherence_one hz]
  ring

end RotationFiber
