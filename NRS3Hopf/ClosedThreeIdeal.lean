module

public import NRS3Hopf.EqualSteps

/-!
# The algebra of the closed axis and its ideals

On the closed axis with three positions, `T°` and `P₃` generate every elementary matrix
`E_ij`, `i ≠ j`: the brackets `ad_{P₃}^k T°` separate the steps of `P₃` (one or two positions),
and two more brackets separate the directions.

So a subspace `J` of traceless matrices, stable under `[T°, ·]` and `[P₃, ·]`, is stable under
every `[E_ij, ·]`. If `J ≠ 0` it contains one `E_pq`: from an off-diagonal entry `x_ij ≠ 0` by
`[E_ji, [E_ji, X]] = −2 x_ij E_ji`, from a diagonal one by `[E_ij, X] = (x_jj − x_ii) E_ij`. And
from one `E_pq` the brackets reach all six.

## Main results

- `ClosedThreeIdeal.single_mem_lieSpan` : `T°`, `P₃` generate every `E_ij`, `i ≠ j`.
- `ClosedThreeIdeal.single_mem` : a nonzero subspace of traceless matrices stable under `T°`
  and `P₃` contains every `E_ij`, `i ≠ j`.
-/

@[expose] public noncomputable section

open Matrix TransportPosition EqualSteps LieClosure

attribute [local instance 100] LieRing.ofAssociativeRing LieAlgebra.ofAssociativeAlgebra

namespace ClosedThreeIdeal

/-- The elementary matrix `E_ij` of the closed axis. -/
abbrev E (i j : Fin 3) : Matrix (Fin 3) (Fin 3) ℂ := single i j 1

/-! ## 1. Brackets of elementary matrices -/

theorem lie_E_E {i j k : Fin 3} (h : k ≠ i) : ⁅E i j, E j k⁆ = E i k := by
  have h0 : E j k * E i j = 0 := by simp [E, h]
  rw [Ring.lie_def, single_mul_single_same, h0, mul_one, sub_zero]

theorem lie_E_E_self {i j : Fin 3} (h : i ≠ j) (X : Matrix (Fin 3) (Fin 3) ℂ) :
    ⁅E j i, ⁅E j i, X⁆⁆ = (-2 * X i j) • E j i := by
  have h0 : E j i * E j i = 0 := by simp [E, h]
  have h1 : E j i * X * E j i = single j i (X i j) := by rw [single_mul_mul_single]; ring_nf
  rw [Ring.lie_def, Ring.lie_def,
    show E j i * (E j i * X - X * E j i) - (E j i * X - X * E j i) * E j i =
      E j i * E j i * X - E j i * X * E j i - E j i * X * E j i + X * (E j i * E j i) by
        noncomm_ring, h0, h1]
  ext a b
  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.zero_mul, Matrix.mul_zero,
    Matrix.zero_apply, Matrix.smul_apply, single_apply, smul_eq_mul]
  split_ifs <;> ring

theorem lie_E_diag {i j : Fin 3} (h : i ≠ j) {X : Matrix (Fin 3) (Fin 3) ℂ}
    (hX : ∀ a b, a ≠ b → X a b = 0) : ⁅E i j, X⁆ = (X j j - X i i) • E i j := by
  have hX' : X = !![X 0 0, 0, 0; 0, X 1 1, 0; 0, 0, X 2 2] := by
    ext a b
    fin_cases a <;> fin_cases b <;> first | rfl | exact hX _ _ (by decide)
  rw [hX']
  ext a b
  fin_cases i <;> fin_cases j <;> (try exact absurd rfl h) <;> fin_cases a <;> fin_cases b <;>
    simp [Ring.lie_def, Matrix.mul_apply, single_apply, Matrix.vecMul, dotProduct]

/-! ## 2. `T°` and `P₃` generate every `E_ij` -/

/-- The algebra generated by `T°` and `P₃`. -/
abbrev closedAlg : LieSubalgebra ℂ (Matrix (Fin 3) (Fin 3) ℂ) :=
  LieSubalgebra.lieSpan ℂ _ {ClosedThree.Tc, Pd 3}

theorem lie_Pd (X : Matrix (Fin 3) (Fin 3) ℂ) :
    ⁅Pd 3, X⁆ = of fun i j => ((posCoord 3 i : ℂ) - posCoord 3 j) * X i j := by
  ext i j
  rw [Ring.lie_def, Matrix.sub_apply, Pd_mul_apply, mul_Pd_apply, of_apply]
  ring

private theorem pc0 : (posCoord 3 0 : ℂ) = -1 := by norm_num [posCoord]
private theorem pc1 : (posCoord 3 1 : ℂ) = 0 := by norm_num [posCoord]
private theorem pc2 : (posCoord 3 2 : ℂ) = 1 := by norm_num [posCoord]

section Gen

local notation "T" => ClosedThree.Tc
local notation "P" => Pd 3

private theorem mem_T : T ∈ closedAlg := LieSubalgebra.subset_lieSpan (by simp)
private theorem mem_P : P ∈ closedAlg := LieSubalgebra.subset_lieSpan (by simp)

/-- `ad_{P₃}^k T°` for `k = 1, 2, 3`. -/
private abbrev X1 := ⁅P, T⁆
private abbrev X2 := ⁅P, X1⁆
private abbrev X3 := ⁅P, X2⁆

private theorem mem_X1 : X1 ∈ closedAlg := LieSubalgebra.lie_mem _ mem_P mem_T
private theorem mem_X2 : X2 ∈ closedAlg := LieSubalgebra.lie_mem _ mem_P mem_X1
private theorem mem_X3 : X3 ∈ closedAlg := LieSubalgebra.lie_mem _ mem_P mem_X2

private theorem E20_eq : E 2 0 = (1 / 3 : ℂ) • (X2 - T) + (1 / 6 : ℂ) • (X3 - X1) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [lie_Pd, ClosedThree.Tc, pc0, pc1, pc2] <;> norm_num

private theorem E02_eq : E 0 2 = (1 / 3 : ℂ) • (X2 - T) - (1 / 6 : ℂ) • (X3 - X1) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [lie_Pd, ClosedThree.Tc, pc0, pc1, pc2] <;> norm_num

private theorem mem_E20 : E 2 0 ∈ closedAlg := by
  rw [E20_eq]
  exact add_mem (LieSubalgebra.smul_mem _ _ (sub_mem mem_X2 mem_T))
    (LieSubalgebra.smul_mem _ _ (sub_mem mem_X3 mem_X1))

private theorem mem_E02 : E 0 2 ∈ closedAlg := by
  rw [E02_eq]
  exact sub_mem (LieSubalgebra.smul_mem _ _ (sub_mem mem_X2 mem_T))
    (LieSubalgebra.smul_mem _ _ (sub_mem mem_X3 mem_X1))

/-- The steps of one position up, `E₁₀ + E₂₁`, and down, `E₀₁ + E₁₂`. -/
private abbrev A1 := T + X1 - (3 / 2 : ℂ) • E 2 0 + (1 / 2 : ℂ) • E 0 2
private abbrev B1 := T - X1 + (1 / 2 : ℂ) • E 2 0 - (3 / 2 : ℂ) • E 0 2

private theorem mem_A1 : A1 ∈ closedAlg :=
  add_mem (sub_mem (add_mem mem_T mem_X1) (LieSubalgebra.smul_mem _ _ mem_E20))
    (LieSubalgebra.smul_mem _ _ mem_E02)

private theorem mem_B1 : B1 ∈ closedAlg :=
  sub_mem (add_mem (sub_mem mem_T mem_X1) (LieSubalgebra.smul_mem _ _ mem_E20))
    (LieSubalgebra.smul_mem _ _ mem_E02)

private theorem A1_eq : A1 = E 1 0 + E 2 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [lie_Pd, ClosedThree.Tc, pc0, pc1, pc2] <;> norm_num

private theorem B1_eq : B1 = E 0 1 + E 1 2 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [lie_Pd, ClosedThree.Tc, pc0, pc1, pc2] <;> norm_num

private theorem lie_E20_B : ⁅E 2 0, E 0 1 + E 1 2⁆ = E 2 1 - E 1 0 := by
  rw [lie_add, lie_E_E (by decide), ← lie_skew, lie_E_E (by decide)]
  abel

private theorem lie_E02_A : ⁅E 0 2, E 1 0 + E 2 1⁆ = E 0 1 - E 1 2 := by
  rw [lie_add, ← lie_skew, lie_E_E (by decide), lie_E_E (by decide)]
  abel

private theorem mem_lie_E20_B : E 2 1 - E 1 0 ∈ closedAlg := by
  rw [← lie_E20_B, ← B1_eq]; exact LieSubalgebra.lie_mem _ mem_E20 mem_B1

private theorem mem_lie_E02_A : E 0 1 - E 1 2 ∈ closedAlg := by
  rw [← lie_E02_A, ← A1_eq]; exact LieSubalgebra.lie_mem _ mem_E02 mem_A1

private theorem comb_eq (x y : Matrix (Fin 3) (Fin 3) ℂ) :
    x = (1 / 2 : ℂ) • ((x + y) - (y - x)) ∧ y = (1 / 2 : ℂ) • ((x + y) + (y - x)) := by
  constructor
  all_goals
    ext i j
    simp only [Matrix.smul_apply, Matrix.add_apply, Matrix.sub_apply, smul_eq_mul]
    ring

private theorem comb_eq' (x y : Matrix (Fin 3) (Fin 3) ℂ) :
    x = (1 / 2 : ℂ) • ((x + y) + (x - y)) ∧ y = (1 / 2 : ℂ) • ((x + y) - (x - y)) := by
  constructor
  all_goals
    ext i j
    simp only [Matrix.smul_apply, Matrix.add_apply, Matrix.sub_apply, smul_eq_mul]
    ring

private theorem mem_E10 : E 1 0 ∈ closedAlg := by
  rw [(comb_eq (E 1 0) (E 2 1)).1, ← A1_eq]
  exact LieSubalgebra.smul_mem _ _ (sub_mem mem_A1 mem_lie_E20_B)

private theorem mem_E21 : E 2 1 ∈ closedAlg := by
  rw [(comb_eq (E 1 0) (E 2 1)).2, ← A1_eq]
  exact LieSubalgebra.smul_mem _ _ (add_mem mem_A1 mem_lie_E20_B)

private theorem mem_E01 : E 0 1 ∈ closedAlg := by
  rw [(comb_eq' (E 0 1) (E 1 2)).1, ← B1_eq]
  exact LieSubalgebra.smul_mem _ _ (add_mem mem_B1 mem_lie_E02_A)

private theorem mem_E12 : E 1 2 ∈ closedAlg := by
  rw [(comb_eq' (E 0 1) (E 1 2)).2, ← B1_eq]
  exact LieSubalgebra.smul_mem _ _ (sub_mem mem_B1 mem_lie_E02_A)

end Gen

/-- **`T°` and `P₃` generate every elementary matrix `E_ij`, `i ≠ j`.** -/
theorem single_mem_lieSpan {i j : Fin 3} (h : i ≠ j) : E i j ∈ closedAlg := by
  fin_cases i <;> fin_cases j
  all_goals first
    | exact absurd rfl h
    | exact mem_E01 | exact mem_E02 | exact mem_E10 | exact mem_E12 | exact mem_E20
    | exact mem_E21

/-! ## 3. Ideals of the closed axis -/

section Ideal

variable {J : Submodule ℂ (Matrix (Fin 3) (Fin 3) ℂ)}
  (hT : ∀ X ∈ J, ⁅ClosedThree.Tc, X⁆ ∈ J) (hP : ∀ X ∈ J, ⁅Pd 3, X⁆ ∈ J)
include hT hP

/-- Stable under `T°` and `P₃`, stable under all of their algebra. -/
theorem lie_mem_of_mem {G : Matrix (Fin 3) (Fin 3) ℂ} (hG : G ∈ closedAlg) :
    ∀ X ∈ J, ⁅G, X⁆ ∈ J := by
  induction hG using LieSubalgebra.lieSpan_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    exacts [hT, hP]
  | zero => intro X _; rw [zero_lie]; exact J.zero_mem
  | add x y _ _ hx hy => intro X hX; rw [add_lie]; exact J.add_mem (hx X hX) (hy X hX)
  | smul a x _ hx => intro X hX; rw [smul_lie]; exact J.smul_mem a (hx X hX)
  | lie x y _ _ hx hy =>
    intro X hX
    rw [lie_lie]
    exact J.sub_mem (hx _ (hy X hX)) (hy _ (hx X hX))

theorem single_step {a b c : Fin 3} (hab : a ≠ b) (hbc : b ≠ c) (hca : c ≠ a)
    (h : E a b ∈ J) : E b a ∈ J ∧ E c b ∈ J ∧ E a c ∈ J := by
  have hL {x y : Fin 3} (hxy : x ≠ y) := lie_mem_of_mem hT hP (single_mem_lieSpan hxy)
  refine ⟨?_, ?_, ?_⟩
  · have h2 := hL hab.symm _ (hL hab.symm _ h)
    rw [lie_E_E_self hab] at h2
    have h3 := J.smul_mem (-1 / 2 : ℂ) h2
    have h1 : E a b a b = 1 := by simp [E]
    rwa [smul_smul, h1, show (-1 / 2 : ℂ) * (-2 * 1) = 1 by norm_num, one_smul] at h3
  · have h2 := hL hca _ h
    rwa [lie_E_E hbc] at h2
  · have h2 := J.neg_mem (hL hbc _ h)
    rwa [← lie_skew, neg_neg, lie_E_E hca] at h2

/-- **A nonzero stable subspace of traceless matrices contains every `E_ij`, `i ≠ j`.** -/
theorem single_mem (htr : ∀ X ∈ J, X.trace = 0) (hne : J ≠ ⊥) {i j : Fin 3} (hij : i ≠ j) :
    E i j ∈ J := by
  have hL {x y : Fin 3} (hxy : x ≠ y) := lie_mem_of_mem hT hP (single_mem_lieSpan hxy)
  obtain ⟨X, hX, hX0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
  -- one elementary matrix
  obtain ⟨p, q, hpq, hE⟩ : ∃ p q : Fin 3, p ≠ q ∧ E p q ∈ J := by
    by_cases hoff : ∃ a b : Fin 3, a ≠ b ∧ X a b ≠ 0
    · obtain ⟨a, b, hab, hx⟩ := hoff
      refine ⟨b, a, hab.symm, ?_⟩
      have h2 := hL hab.symm _ (hL hab.symm _ hX)
      rw [lie_E_E_self hab] at h2
      have h3 := J.smul_mem (-2 * X a b)⁻¹ h2
      rwa [smul_smul, inv_mul_cancel₀ (mul_ne_zero (by norm_num) hx), one_smul] at h3
    · push Not at hoff
      have hdiag : ∃ a b : Fin 3, a ≠ b ∧ X b b - X a a ≠ 0 := by
        by_contra hc
        push Not at hc
        apply hX0
        have h01 := hc 0 1 (by decide)
        have h02 := hc 0 2 (by decide)
        have htr' := htr X hX
        rw [Matrix.trace_fin_three] at htr'
        have hx0 : X 0 0 = 0 := by linear_combination htr' / 3 - h01 / 3 - h02 / 3
        ext a b
        by_cases hab : a = b
        · subst hab
          fin_cases a
          · exact hx0
          · simp only [Fin.mk_one, Matrix.zero_apply]; linear_combination h01 + hx0
          · simp only [Fin.reduceFinMk, Matrix.zero_apply]; linear_combination h02 + hx0
        · exact hoff a b hab
      obtain ⟨a, b, hab, hx⟩ := hdiag
      refine ⟨a, b, hab, ?_⟩
      have h2 := hL hab _ hX
      rw [lie_E_diag hab hoff] at h2
      have h3 := J.smul_mem (X b b - X a a)⁻¹ h2
      rwa [smul_smul, inv_mul_cancel₀ hx, one_smul] at h3
  -- all six
  obtain ⟨r, hrp, hrq⟩ : ∃ r : Fin 3, r ≠ p ∧ r ≠ q := by
    fin_cases p <;> fin_cases q <;> first | exact absurd rfl hpq | decide
  obtain ⟨hqp, hrq', hpr⟩ := single_step hT hP hpq hrq.symm hrp hE
  obtain ⟨hqr, hpq', hrp'⟩ := single_step hT hP hrq hpq.symm hrp.symm hrq'
  have hall (x : Fin 3) : x = p ∨ x = q ∨ x = r := by
    fin_cases x <;> fin_cases p <;> fin_cases q <;> fin_cases r <;> simp_all
  rcases hall i with rfl | rfl | rfl <;> rcases hall j with rfl | rfl | rfl
  all_goals first | exact absurd rfl hij | assumption

end Ideal

end ClosedThreeIdeal
