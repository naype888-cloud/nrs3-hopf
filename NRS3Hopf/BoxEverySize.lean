module

public import NRS3Hopf.RobertsonEqualityPlane
public import NRS3Hopf.BoxTwoRelations
public import NRS3Hopf.ClosedThreeIdeal
public import NRS3Hopf.ClosedAxisEntangled

/-!
# Equality on the box leaves no state, for every size of `x`, `y`, `z`

On the box `dx × dy × dz × 3` with the closed fiber in its band, suppose Robertson 1934 is an
equality with `det Ω ≠ 0`. The relations cross the fiber in both directions
(`RobertsonEqualityPlane`): two of them, `a` and `b`, have fiber parts `T°` and `P₃`. Let `𝔤` be
the Lie algebra generated by the relations, axis by axis. `Φ` is an eigenvector of all of `𝔤`,
so every bracket of `𝔤` annihilates `Φ`.

* **One axis at a time.** On an open axis the parts of `a`, `b` are combinations of `T_d`,
  `P_d`. Either they are dependent, and a combination of `a`, `b` vanishes on the axis but not on
  the fiber; or they give `T_d` and `P_d` themselves, and `[P_d, [P_d, T_d]] − h² T_d` vanishes
  on the axis by equal steps (`EqualSteps`), while on the fiber it does not.
* **The fiber.** The fiber parts of the elements of `𝔤` vanishing on one axis form a nonzero
  subspace of traceless matrices stable under `T°` and `P₃`, so they contain every `E_ij`
  (`ClosedThreeIdeal`).
* **The three axes.** With `Z_x`, `Z_y`, `Z_z` vanishing on `x`, `y`, `z` and fiber parts `E₀₁`,
  `E₁₂`, `E₂₀`, the brackets `[[Z_x, Z_y], Z_z]` and `[[Z_y, Z_z], Z_x]` vanish on `x`, `y`, `z`
  and are `E₀₀ − E₂₂` and `E₁₁ − E₀₀` on the fiber. Both annihilate `Φ`, and they have no common
  kernel: `Φ = 0`.

No size of `x`, `y`, `z` is excluded: equal steps hold for every `d`.

## Main results

- `BoxEverySize.exists_off_axis` : one axis at a time.
- `BoxEverySize.eig`, `BoxEverySize.kill` : `Φ` is an eigenvector of the algebra of the
  relations, and its brackets annihilate `Φ`.
- `BoxEverySize.trace_πw` : its fiber parts are traceless.

The three axes are put together in `BoxEveryStrict`.
-/

@[expose] public noncomputable section

open Matrix TransportPosition PathGraph3DNRS RobertsonDeterminant FourAxes CubeInBox
open BoxTwoRelations ClosedThreeIdeal EqualSteps RobertsonEquality BoxFiberLine

attribute [local instance 100] LieRing.ofAssociativeRing LieAlgebra.ofAssociativeAlgebra

namespace BoxEverySize

/-! ## 1. One axis at a time -/

section OneAxis

variable {M : Type*} [LieRing M] [LieAlgebra ℂ M] {d : ℕ}
  (π : M →ₗ⁅ℂ⁆ Matrix (Fin d) (Fin d) ℂ) (ρ : M →ₗ⁅ℂ⁆ Matrix (Fin 3) (Fin 3) ℂ)
  {𝔤 : LieSubalgebra ℂ M} {La Lb : M} {a₀ a₁ b₀ b₁ : ℂ}

theorem Tc_P_indep {p q : ℂ} (h : p • ClosedThree.Tc + q • Pd 3 = 0) : p = 0 ∧ q = 0 := by
  have h01 := congrFun (congrFun h 0) 1
  have h00 := congrFun (congrFun h 0) 0
  simp [ClosedThree.Tc, Pd, posCoord] at h01 h00
  norm_num at h00
  exact ⟨h01, h00⟩

/-- **One axis at a time**: some element of `𝔤` vanishes on the axis and not on the fiber. -/
theorem exists_off_axis (ha : La ∈ 𝔤) (hb : Lb ∈ 𝔤)
    (hπa : π La = a₀ • Td d + a₁ • Pd d) (hπb : π Lb = b₀ • Td d + b₁ • Pd d)
    (hρa : ρ La = ClosedThree.Tc) (hρb : ρ Lb = Pd 3) :
    ∃ Z ∈ 𝔤, π Z = 0 ∧ ρ Z ≠ 0 := by
  set Δ := a₀ * b₁ - a₁ * b₀
  have comb (p q : ℂ) : π (p • La + q • Lb) =
      (p * a₀ + q * b₀) • Td d + (p * a₁ + q * b₁) • Pd d := by
    rw [map_add, map_smul, map_smul, hπa, hπb]; module
  have combρ (p q : ℂ) : ρ (p • La + q • Lb) = p • ClosedThree.Tc + q • Pd 3 := by
    rw [map_add, map_smul, map_smul, hρa, hρb]
  have mem (p q : ℂ) : p • La + q • Lb ∈ 𝔤 :=
    add_mem (LieSubalgebra.smul_mem _ _ ha) (LieSubalgebra.smul_mem _ _ hb)
  by_cases hΔ : Δ = 0
  · -- dependent parts: a combination vanishes on the axis
    obtain ⟨p, q, hpq, h0, h1⟩ : ∃ p q : ℂ, (p ≠ 0 ∨ q ≠ 0) ∧ p * a₀ + q * b₀ = 0 ∧
        p * a₁ + q * b₁ = 0 := by
      by_cases h0 : a₀ = 0 ∧ b₀ = 0
      · by_cases h1 : a₁ = 0 ∧ b₁ = 0
        · exact ⟨1, 0, Or.inl one_ne_zero, by simp [h0.1], by simp [h1.1]⟩
        · refine ⟨b₁, -a₁, ?_, by simp [h0.1, h0.2], by ring⟩
          by_contra hc; push Not at hc; exact h1 ⟨by simpa using hc.2, hc.1⟩
      · refine ⟨b₀, -a₀, ?_, by ring, by linear_combination -hΔ⟩
        by_contra hc; push Not at hc; exact h0 ⟨by simpa using hc.2, hc.1⟩
    refine ⟨p • La + q • Lb, mem p q, by rw [comb, h0, h1, zero_smul, zero_smul, add_zero],
      fun hz => ?_⟩
    rw [combρ] at hz
    obtain ⟨hp, hq⟩ := Tc_P_indep hz
    rcases hpq with h | h <;> contradiction
  · -- independent parts: they give `T_d` and `P_d`, and equal steps
    set A := (b₁ / Δ) • La + (-a₁ / Δ) • Lb
    set B := (-b₀ / Δ) • La + (a₀ / Δ) • Lb
    have hA : π A = Td d := by
      rw [comb, show b₁ / Δ * a₀ + -a₁ / Δ * b₀ = 1 by field_simp; ring,
        show b₁ / Δ * a₁ + -a₁ / Δ * b₁ = 0 by ring, one_smul, zero_smul, add_zero]
    have hB : π B = Pd d := by
      rw [comb, show -b₀ / Δ * a₀ + a₀ / Δ * b₀ = 0 by ring,
        show -b₀ / Δ * a₁ + a₀ / Δ * b₁ = 1 by field_simp; ring, one_smul, zero_smul, zero_add]
    set c : ℂ := ((2 : ℂ) / ((d : ℂ) - 1)) ^ 2
    refine ⟨⁅B, ⁅B, A⁆⁆ - c • A, sub_mem (LieSubalgebra.lie_mem _ (mem _ _)
      (LieSubalgebra.lie_mem _ (mem _ _) (mem _ _))) (LieSubalgebra.smul_mem _ _ (mem _ _)), ?_, ?_⟩
    · rw [map_sub, map_smul, LieHom.map_lie, LieHom.map_lie, hA, hB, lie_Pd_Pd_Td, sub_self]
    · rw [map_sub, map_smul, LieHom.map_lie, LieHom.map_lie, combρ, combρ, sub_ne_zero]
      refine closed_ne ?_
      rw [show b₁ / Δ * (a₀ / Δ) - -a₁ / Δ * (-b₀ / Δ) = 1 / Δ by field_simp; ring]
      exact one_div_ne_zero hΔ

end OneAxis

/-! ## 2. The algebra of the relations -/

section Box

variable {dx dy dz : ℕ}

/-- The eight observables of the box with the closed fiber are symmetric. -/
theorem boxPairs_isSymmetric (p : Fin 2 × Fin 4) :
    (boxPairs dx dy dz 3 closedPair p).IsSymmetric := by
  obtain ⟨s, i⟩ := p
  have hT (d : ℕ) : (![Td d, Pd d] s).IsHermitian := by
    fin_cases s
    exacts [Td_isHermitian d, Pd_isHermitian d]
  match i with
  | 0 => rw [BoxCommute.box_x]
         exact Matrix.isSymmetric_toEuclideanLin_iff.mpr
           (RobertsonDeterminant3D.liftAlong_isHermitian _ (hT dx))
  | 1 => rw [BoxCommute.box_y]
         exact Matrix.isSymmetric_toEuclideanLin_iff.mpr
           (RobertsonDeterminant3D.liftAlong_isHermitian _ (hT dy))
  | 2 => rw [BoxCommute.box_z]
         exact Matrix.isSymmetric_toEuclideanLin_iff.mpr
           (RobertsonDeterminant3D.liftAlong_isHermitian _ (hT dz))
  | 3 => rw [BoxCommute.box_w]
         exact Matrix.isSymmetric_toEuclideanLin_iff.mpr
           (RobertsonDeterminant3D.liftAlong_isHermitian _ (closedPair_isHermitian s))

/-- The four projections of the axes, as Lie homomorphisms. -/
def πx : Axes dx dy dz →ₗ⁅ℂ⁆ Matrix (Fin dx) (Fin dx) ℂ := (AlgHom.fst ℂ _ _).toLieHom
def πy : Axes dx dy dz →ₗ⁅ℂ⁆ Matrix (Fin dy) (Fin dy) ℂ :=
  ((AlgHom.fst ℂ _ _).comp (AlgHom.snd ℂ _ _)).toLieHom
def πz : Axes dx dy dz →ₗ⁅ℂ⁆ Matrix (Fin dz) (Fin dz) ℂ :=
  ((AlgHom.fst ℂ _ _).comp ((AlgHom.snd ℂ _ _).comp (AlgHom.snd ℂ _ _))).toLieHom
def πw : Axes dx dy dz →ₗ⁅ℂ⁆ Matrix (Fin 3) (Fin 3) ℂ :=
  ((AlgHom.snd ℂ _ _).comp ((AlgHom.snd ℂ _ _).comp (AlgHom.snd ℂ _ _))).toLieHom

@[simp] theorem πx_apply (Z : Axes dx dy dz) : πx Z = Z.1 := rfl
@[simp] theorem πy_apply (Z : Axes dx dy dz) : πy Z = Z.2.1 := rfl
@[simp] theorem πz_apply (Z : Axes dx dy dz) : πz Z = Z.2.2.1 := rfl
@[simp] theorem πw_apply (Z : Axes dx dy dz) : πw Z = Z.2.2.2 := rfl

theorem lam_smul (c : ℂ) (Z : Axes dx dy dz) : lam (c • Z) = c • lam Z := by
  simp only [lam, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Prod.smul_fst, Prod.smul_snd,
    liftAlong_smul, smul_add]

variable (Φ : H4D dx dy dz 3)

/-- The relations at `Φ`. -/
def rel : Set (Fin 2 × Fin 4 → ℂ) :=
  {c | gram ℂ (fluct (boxPairs dx dy dz 3 closedPair) Φ) *ᵥ c = 0}

/-- The Lie algebra generated by the relations, axis by axis. -/
def alg : LieSubalgebra ℂ (Axes dx dy dz) := LieSubalgebra.lieSpan ℂ _ (axesOf '' rel Φ)

/-- **`Φ` is an eigenvector of the whole algebra.** -/
theorem eig {Z : Axes dx dy dz} (hZ : Z ∈ alg Φ) : ∃ μ : ℂ, toOp (lam Z) Φ = μ • Φ := by
  induction hZ using LieSubalgebra.lieSpan_induction with
  | mem x hx =>
    obtain ⟨c, hc, rfl⟩ := hx
    exact ⟨_, eig_of_relation (sum_eq_zero_of_mulVec _ Φ hc)⟩
  | zero => exact ⟨0, by simp [toOp_apply]⟩
  | add x y _ _ hx hy =>
    obtain ⟨μ, hμ⟩ := hx
    obtain ⟨ν, hν⟩ := hy
    exact ⟨μ + ν, by rw [map_add, map_add, LinearMap.add_apply, hμ, hν, add_smul]⟩
  | smul a x _ hx =>
    obtain ⟨μ, hμ⟩ := hx
    refine ⟨a * μ, ?_⟩
    rw [lam_smul, toOp_apply, map_smul, LinearMap.smul_apply, ← toOp_apply, hμ, smul_smul]
  | lie x y _ _ hx hy =>
    obtain ⟨μ, hμ⟩ := hx
    obtain ⟨ν, hν⟩ := hy
    exact ⟨0, by rw [lam_lie, toOp_lie, zero_smul]; exact lie_apply_eq_zero hμ hν⟩

/-- **Every bracket of the algebra annihilates `Φ`.** -/
theorem kill {X Y : Axes dx dy dz} (hX : X ∈ alg Φ) (hY : Y ∈ alg Φ) :
    toOp (lam ⁅X, Y⁆) Φ = 0 := by
  obtain ⟨μ, hμ⟩ := eig Φ hX
  obtain ⟨ν, hν⟩ := eig Φ hY
  rw [lam_lie, toOp_lie]
  exact lie_apply_eq_zero hμ hν

theorem trace_πw {Z : Axes dx dy dz} (hZ : Z ∈ alg Φ) : (πw Z).trace = 0 := by
  induction hZ using LieSubalgebra.lieSpan_induction with
  | mem x hx =>
    obtain ⟨c, -, rfl⟩ := hx
    simp [axesOf, Matrix.trace_fin_three, ClosedThree.Tc, Pd, posCoord]
    norm_num
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, Matrix.trace_add, hx, hy, add_zero]
  | smul a x _ hx => rw [map_smul, Matrix.trace_smul, hx, smul_zero]
  | lie x y _ _ _ _ =>
    rw [LieHom.map_lie, Ring.lie_def, Matrix.trace_sub, Matrix.trace_mul_comm, sub_self]

end Box

end BoxEverySize
